# Buildroot / custom kernel fragment for a fast Linux guest.
# Goal: small vmlinux that speaks virtio-mmio + virtio-pci, no desktop bloat.

CONFIG_EXPERT=y
CONFIG_64BIT=y
CONFIG_SMP=y
CONFIG_HZ_1000=y
CONFIG_PREEMPT=y
CONFIG_NO_HZ_IDLE=y
CONFIG_HIGH_RES_TIMERS=y

# boot
CONFIG_PVH=y
CONFIG_KEXEC=n
CONFIG_EFI=n

# virtio
CONFIG_VIRTIO=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_MMIO_CMDLINE_DEVICES=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_VIRTIO_BALLOON=y
CONFIG_VIRTIO_VSOCKETS=y
CONFIG_HW_RANDOM_VIRTIO=y
CONFIG_VIRTIO_INPUT=y

# filesystems
CONFIG_EXT4_FS=y
CONFIG_OVERLAY_FS=y
CONFIG_SQUASHFS=y
CONFIG_TMPFS=y

# net
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_NETDEVICES=y

# shrink
CONFIG_MODULES=n
CONFIG_USB=n
CONFIG_SOUND=n
CONFIG_DRM=n
CONFIG_WLAN=n
CONFIG_BT=n
CONFIG_DEBUG_KERNEL=n
CONFIG_KALLSYMS=n
