{
  "name": "windows-qga",
  "backend": "qemu",
  "image": "/var/lib/fluxvm/images/windows-custom.qcow2",
  "vcpus": 2,
  "memory_mib": 4096,
  "disk_size_gib": 40,
  "firmware": "/usr/share/OVMF/OVMF_CODE.fd",
  "network": {
    "mode": "user",
    "forwards": [
      { "host_port": 3389, "guest_port": 3389 },
      { "host_port": 8080, "guest_port": 8080 }
    ]
  },
  "qga": { "enabled": true },
  "ttl_seconds": 7200
}
